// Taiwan Stock Industry Radar — Prisma schema
// Provider is postgresql. Local dev needs a Postgres URL too (Docker or a
// Neon dev branch) — see README.md "Database setup".

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (PgBouncer). Vercel's Neon integration injects both.
  url       = env("DATABASE_URL")
  // Direct connection. `prisma migrate` must bypass the pooler or it hangs.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------------------------------------------------------------------------
// Reference / provenance
// ---------------------------------------------------------------------------

/// A data provider/source, real or mock. Every fact in the system should be
/// traceable back to one of these so the UI can label mock vs. real data.
model DataSource {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "mock-freight", "twse", "taifex"
  name        String
  category    String // "market_data" | "institutional_flow" | "indicator" | "news" | "fundamental"
  url         String?
  isMock      Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  indicatorValues IndicatorValue[]
  marketData      MarketData[]
  flows           InstitutionalFlow[]
  catalysts       Catalyst[]

  @@map("data_sources")
}

// ---------------------------------------------------------------------------
// Core taxonomy
// ---------------------------------------------------------------------------

model Industry {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  nameZh      String?
  description String?

  /// Current investment thesis, one short paragraph.
  thesis String?

  /// Single headline risk sentence for compact display (radar cards, KPI
  /// strips). The fuller multi-item risk list stays authored copy in
  /// prisma/seed-data.ts (SeedIndustry.risks) — this column captures just
  /// the top item so it can render without an extra join.
  primaryRisk String?

  /// "early" | "expansion" | "peak" | "contraction" | "trough"
  cyclePosition String @default("expansion")

  /// "low" | "medium" | "high"
  riskLevel String @default("medium")

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks     Stock[]
  indicators Indicator[]
  catalysts  Catalyst[]
  scores     IndustryScore[]
  sentiment  IndustrySentimentSnapshot[]
  alerts     Alert[]
  flows      InstitutionalFlow[]
  watchlist  WatchlistItem[]

  @@map("industries")
}

model Stock {
  id         String  @id @default(cuid())
  ticker     String  @unique
  name       String
  nameZh     String?
  exchange   String  @default("TWSE") // TWSE | TPEx
  industryId String

  /// Finer-grained classification inside the parent industry (e.g. "ABF
  /// Substrate" inside PCB). Drives the 細產業 tab of the Industry Momentum
  /// module, which scores these sub-groups with the same sentiment formula
  /// the parent industries use. Nullable: a stock with no sub-classification
  /// is grouped under its industry name rather than being dropped.
  subIndustry   String?
  subIndustryZh String?

  /// "early_strengthening" | "trend_confirmed" | "high_level_consolidation"
  /// | "potential_catch_up" | "overheated" | "weakening"
  status String @default("early_strengthening")

  mainCatalyst String?
  mainRisk     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  industry     Industry            @relation(fields: [industryId], references: [id])
  marketData   MarketData[]
  catalysts    Catalyst[]
  flows        InstitutionalFlow[]
  fundamentals StockFundamental[]
  alertLinks   AlertStock[]
  watchlist    WatchlistItem[]

  @@index([industryId])
  @@index([industryId, subIndustry])
  @@map("stocks")
}

// ---------------------------------------------------------------------------
// Leading indicators (industry-specific, e.g. SCFI, DRAM price, CapEx)
// ---------------------------------------------------------------------------

model Indicator {
  id             String  @id @default(cuid())
  industryId     String
  key            String // e.g. "scfi", "dram_contract_price"
  name           String
  nameZh         String?
  unit           String? // "USD/TEU", "index", "USD", "%"
  description    String?
  frequency      String  @default("weekly") // daily | weekly | monthly | quarterly
  /// true when a rising value is bullish for the industry, false when a rising
  /// value is bearish (e.g. rising inventory is usually bearish).
  higherIsBetter Boolean @default(true)
  sortOrder      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  industry  Industry         @relation(fields: [industryId], references: [id])
  values    IndicatorValue[]
  watchlist WatchlistItem[]

  @@unique([industryId, key])
  @@map("indicators")
}

model IndicatorValue {
  id            String   @id @default(cuid())
  indicatorId   String
  date          DateTime
  value         Float
  previousValue Float?
  pctChange     Float?
  dataSourceId  String?
  sourceUrl     String?
  dataTimestamp DateTime @default(now())
  isMock        Boolean  @default(true)

  createdAt DateTime @default(now())

  indicator  Indicator   @relation(fields: [indicatorId], references: [id])
  dataSource DataSource? @relation(fields: [dataSourceId], references: [id])

  @@unique([indicatorId, date])
  @@index([indicatorId, date])
  @@map("indicator_values")
}

// ---------------------------------------------------------------------------
// Scoring
// ---------------------------------------------------------------------------

/// Singleton-ish configurable weighting used to compute IndustryScore.total.
/// Kept as a table (not hard-coded) so weights can be tuned via admin/API.
model ScoreWeightConfig {
  id                     String   @id @default(cuid())
  name                   String   @unique @default("default")
  fundamentalWeight      Float    @default(0.30)
  leadingIndicatorWeight Float    @default(0.25)
  capitalFlowWeight      Float    @default(0.20)
  technicalWeight        Float    @default(0.15)
  catalystWeight         Float    @default(0.10)
  isActive               Boolean  @default(true)
  updatedAt              DateTime @updatedAt
  createdAt              DateTime @default(now())

  @@map("score_weight_configs")
}

model IndustryScore {
  id         String   @id @default(cuid())
  industryId String
  date       DateTime

  fundamentalScore      Float
  leadingIndicatorScore Float
  capitalFlowScore      Float
  technicalScore        Float
  catalystScore         Float

  totalScore Float

  /// snapshot of the weights used, so historical scores stay reproducible
  /// even if weights change later. Stored as JSON string.
  weightsSnapshot String

  /// "accelerating" | "strengthening" | "neutral" | "weakening" | "overheated"
  status String @default("neutral")

  createdAt DateTime @default(now())

  industry Industry @relation(fields: [industryId], references: [id])

  @@unique([industryId, date])
  @@index([industryId, date])
  @@map("industry_scores")
}

// ---------------------------------------------------------------------------
// Market data & fundamentals
// ---------------------------------------------------------------------------

model MarketData {
  id                String   @id @default(cuid())
  stockId           String
  date              DateTime
  open              Float
  high              Float
  low               Float
  close             Float
  volume            Float
  change            Float
  changePct         Float
  relativeStrength  Float? // vs. TAIEX, 100 = inline with market
  technicalTrend    String   @default("neutral") // "uptrend" | "downtrend" | "neutral" | "breakout" | "breakdown"
  valuationPosition String   @default("mid_range") // "low" | "mid_range" | "high" | "extended"
  dataSourceId      String?
  isMock            Boolean  @default(true)

  createdAt DateTime @default(now())

  stock      Stock       @relation(fields: [stockId], references: [id])
  dataSource DataSource? @relation(fields: [dataSourceId], references: [id])

  @@unique([stockId, date])
  @@index([stockId, date])
  @@map("market_data")
}

/// Revenue / EPS style fundamentals: monthly revenue, or year-to-date EPS.
model StockFundamental {
  id           String   @id @default(cuid())
  stockId      String
  /// "2026-07" (monthly revenue) or "2026Q2" (year-to-date EPS through the
  /// quarter the statement closes — MOPS files these cumulatively from January,
  /// so only a Q1 row is ever a single quarter).
  period       String
  periodType   String // "monthly_revenue" | "ytd_eps"
  value        Float
  yoyChangePct Float?
  momChangePct Float?
  eps          Float?
  isMock       Boolean  @default(true)
  createdAt    DateTime @default(now())

  stock Stock @relation(fields: [stockId], references: [id])

  @@unique([stockId, period, periodType])
  @@index([stockId])
  @@map("stock_fundamentals")
}

// ---------------------------------------------------------------------------
// Institutional / capital flow
// ---------------------------------------------------------------------------

model InstitutionalFlow {
  id         String   @id @default(cuid())
  date       DateTime
  scope      String // "market" | "industry" | "stock"
  industryId String?
  stockId    String?

  foreignNet      Float @default(0) // NT$ thousands
  trustNet        Float @default(0)
  dealerNet       Float @default(0)
  marginChange    Float @default(0) // change in margin financing balance
  turnover        Float @default(0) // NT$ thousands traded
  volumeChangePct Float @default(0)
  breakoutCount   Int   @default(0) // # of stocks breaking out (industry scope)

  dataSourceId String?
  isMock       Boolean  @default(true)
  createdAt    DateTime @default(now())

  industry   Industry?   @relation(fields: [industryId], references: [id])
  stock      Stock?      @relation(fields: [stockId], references: [id])
  dataSource DataSource? @relation(fields: [dataSourceId], references: [id])

  @@index([scope, date])
  @@index([industryId, date])
  @@index([stockId, date])
  @@map("institutional_flows")
}

// ---------------------------------------------------------------------------
// Catalysts / news
// ---------------------------------------------------------------------------

model Catalyst {
  id           String   @id @default(cuid())
  industryId   String?
  stockId      String?
  title        String
  description  String?
  date         DateTime
  /// "high" | "medium" | "low"
  importance   String   @default("medium")
  source       String?
  sourceUrl    String?
  dataSourceId String?
  isMock       Boolean  @default(true)
  createdAt    DateTime @default(now())

  industry   Industry?   @relation(fields: [industryId], references: [id])
  stock      Stock?      @relation(fields: [stockId], references: [id])
  dataSource DataSource? @relation(fields: [dataSourceId], references: [id])

  @@index([industryId, date])
  @@index([stockId, date])
  @@map("catalysts")
}

// ---------------------------------------------------------------------------
// Alerts
// ---------------------------------------------------------------------------

model Alert {
  id              String   @id @default(cuid())
  timestamp       DateTime @default(now())
  industryId      String?
  ruleKey         String // e.g. "scfi_2wk_rise", "foreign_buy_streak"
  title           String
  description     String
  /// "high" | "medium" | "low"
  importance      String
  sourceIndicator String?
  change          String?
  explanation     String
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  industry Industry?    @relation(fields: [industryId], references: [id])
  stocks   AlertStock[]

  @@index([timestamp])
  @@index([industryId])
  @@map("alerts")
}

/// Join table: which stocks an alert is related to.
model AlertStock {
  id      String @id @default(cuid())
  alertId String
  stockId String

  alert Alert @relation(fields: [alertId], references: [id])
  stock Stock @relation(fields: [stockId], references: [id])

  @@unique([alertId, stockId])
  @@map("alert_stocks")
}

// ---------------------------------------------------------------------------
// Daily AI brief
// ---------------------------------------------------------------------------

model DailyBrief {
  id   String   @id @default(cuid())
  date DateTime @unique

  marketSummary           String
  strongestIndustries     String // JSON array
  weakestIndustries       String // JSON array
  capitalRotation         String
  leadingIndicatorChanges String // JSON array
  institutionalActivity   String
  emergingThemes          String // JSON array
  stocksToWatch           String // JSON array
  overheatedThemes        String // JSON array
  keyRisks                String // JSON array
  tomorrowWatchlist       String // JSON array

  /// Short-term Industry Sentiment reporting (spec §12). Defaults keep rows
  /// written before the sentiment module existed readable.
  sentimentSummary        String @default("")
  sentimentRising         String @default("[]") // JSON array — 氣氛值上升最快族群
  sentimentFalling        String @default("[]") // JSON array — 氣氛值下降最快族群
  sentimentRankJumps      String @default("[]") // JSON array — 排名躍升最多族群
  sentimentStrongClusters String @default("[]") // JSON array — 強勢群聚族群
  sentimentOverheated     String @default("[]") // JSON array — 短線過熱族群

  knownFacts          String // JSON array
  reasonableInference String // JSON array
  uncertainty         String // JSON array

  /// "mock" | "openai" | "claude"
  generatedBy String   @default("mock")
  createdAt   DateTime @default(now())

  @@map("daily_briefs")
}

// ---------------------------------------------------------------------------
// Watchlist
// ---------------------------------------------------------------------------

model WatchlistItem {
  id          String   @id @default(cuid())
  /// "industry" | "stock" | "indicator"
  itemType    String
  industryId  String?
  stockId     String?
  indicatorId String?
  note        String?
  createdAt   DateTime @default(now())

  industry  Industry?  @relation(fields: [industryId], references: [id])
  stock     Stock?     @relation(fields: [stockId], references: [id])
  indicator Indicator? @relation(fields: [indicatorId], references: [id])

  // A compound unique across nullable columns does not dedupe on SQLite
  // (NULLs compare as distinct), so uniqueness is enforced in the mutation
  // layer instead — see src/app/watchlist/actions.ts.
  @@index([itemType])
  @@map("watchlist_items")
}

// ---------------------------------------------------------------------------
// Market-wide snapshot (TAIEX etc.)
// ---------------------------------------------------------------------------

model MarketStatus {
  id               String   @id @default(cuid())
  date             DateTime @unique
  index            String   @default("TAIEX")
  close            Float
  change           Float
  changePct        Float
  volume           Float
  breadthAdvancers Int      @default(0)
  breadthDecliners Int      @default(0)
  foreignNet       Float    @default(0)
  trustNet         Float    @default(0)
  dealerNet        Float    @default(0)
  marginChange     Float    @default(0)
  isMock           Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@map("market_status")
}

// ---------------------------------------------------------------------------
// Short-term sentiment / momentum (產業氣氛)
//
// Deliberately SEPARATE from IndustryScore (the medium-term Industry Heat
// Score). Heat answers "is this a good industry to own over the coming
// weeks"; sentiment answers "is this industry strengthening TODAY, and is
// the whole group participating". The two are read side by side (spec §10
// Case A-D) precisely because they can disagree, so they never share a
// table, a weight config, or a status vocabulary.
// ---------------------------------------------------------------------------

/// Configurable weighting for the Industry Sentiment Score. Mirrors
/// ScoreWeightConfig: a table rather than constants so weights are tunable
/// via /api/sentiment-weights without a redeploy, and never hard-coded in
/// UI components.
model SentimentWeightConfig {
  id                       String   @id @default(cuid())
  name                     String   @unique @default("default")
  advancingRatioWeight     Float    @default(0.25)
  averageReturnWeight      Float    @default(0.20)
  volumeExpansionWeight    Float    @default(0.15)
  breakoutRatioWeight      Float    @default(0.15)
  institutionalFlowWeight  Float    @default(0.15)
  relativeStrengthWeight   Float    @default(0.10)
  isActive                 Boolean  @default(true)
  updatedAt                DateTime @updatedAt
  createdAt                DateTime @default(now())

  @@map("sentiment_weight_configs")
}

/// One row per industry per session: the 0-100 Industry Sentiment Score, the
/// six component scores behind it, the raw measures the UI displays
/// (breadth counts, volume ratio, net institutional flow), and the ranking
/// bookkeeping that makes "#9 → #1 ↑8" possible.
model IndustrySentimentSnapshot {
  id         String   @id @default(cuid())
  industryId String
  date       DateTime

  sentimentScore Float

  // --- component scores, each 0-100 ---------------------------------------
  advancingRatio         Float
  averageReturn          Float
  volumeExpansion        Float
  breakoutRatio          Float
  institutionalFlowScore Float
  relativeStrengthScore  Float

  // --- raw measures the components were derived from ----------------------
  // Stored alongside the scores so the table can show "8↑ / 1→ / 1↓" and
  // "1.8x" without re-deriving them, and so a stored score always remains
  // explainable from the same row.
  /// Share of member stocks up today, 0-1.
  advancingSharePct Float @default(0)
  advancingCount    Int   @default(0)
  flatCount         Int   @default(0)
  decliningCount    Int   @default(0)
  stockCount        Int   @default(0)
  /// Equal-weighted average daily return of member stocks, in percent.
  averageReturnPct  Float @default(0)
  /// Session turnover / trailing 20-session average turnover, e.g. 1.8.
  volumeRatio       Float @default(1)
  breakoutCount     Int   @default(0)
  foreignNet        Float @default(0)
  trustNet          Float @default(0)
  dealerNet         Float @default(0)
  /// Industry return minus TAIEX return for the session, in percentage points.
  relativeStrengthPct Float @default(0)

  // --- ranking ------------------------------------------------------------
  rank         Int
  previousRank Int?
  /// Rank five sessions earlier, for the "#11 → #8 → #6 → #3 → #1" trend.
  rank5dAgo    Int?
  /// previousRank - rank. Positive means the industry climbed the ranking.
  rankDelta    Int  @default(0)

  /// "strong_cluster" | "accelerating" | "bullish" | "mild_bullish"
  /// | "neutral" | "mild_bearish" | "weakening" | "weak_cluster" | "overheated"
  status String @default("neutral")

  /// Snapshot of the weights used, so a historical sentiment score stays
  /// reproducible after the weights are retuned.
  weightsSnapshot String

  createdAt DateTime @default(now())

  industry Industry @relation(fields: [industryId], references: [id])

  @@unique([industryId, date])
  @@index([industryId, date])
  @@index([date, rank])
  @@map("industry_sentiment_snapshots")
}
