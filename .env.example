# Copy to .env.

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# DATABASE_URL is the pooled connection the app runs on.
# DATABASE_URL_UNPOOLED is the direct connection `prisma migrate` needs — a
# migration run through a transaction pooler hangs. BOTH are required: Prisma
# refuses to load the schema if either is unset, so `prisma generate` fails at
# build time too.
#
# Vercel + Neon (Storage -> Neon) injects both names automatically.
# On a plain Postgres with no pooler, point them at the same string.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/dbname?sslmode=require"

# ---------------------------------------------------------------------------
# Data providers
# ---------------------------------------------------------------------------
# "live" (default) pulls official TWSE / TPEx / MOPS / SEC feeds. No API key
# is needed — every source is public — but outbound HTTPS must be allowed.
# "mock" restores the synthetic demo dataset. The two are mutually exclusive
# on purpose: a half-live database (real prices, invented flows) is worse than
# either. Switching modes means re-seeding.
DATA_MODE="live"

# Contact string sent as the User-Agent to SEC EDGAR (hyperscaler capex
# indicator). SEC requires automated clients to identify themselves and blocks
# anonymous ones, so with this unset that indicator is skipped. Use a contact
# that is yours to publish, e.g. "stock-data-tracker (contact: you@example.com)".
SEC_USER_AGENT=""

# ---------------------------------------------------------------------------
# AI daily brief
# ---------------------------------------------------------------------------
# "mock" (default) uses a rule-based composer and needs no API key.
# "openai" or "claude" call the real APIs and fall back to mock on failure.
AI_PROVIDER="mock"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Per-request timeout for the OpenAI / Claude call, in milliseconds. A call
# that times out falls back to the mock composer like any other failure.
AI_TIMEOUT_MS="60000"

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------
# Required in production: POST /api/jobs/* checks this as a bearer token.
# With no secret set, the job routes are allowed only outside production.
CRON_SECRET=""

# Used by `npm run cron` (the long-running scheduler). Both legs follow the
# TWSE trading calendar in src/lib/market-session.ts and do nothing on
# weekends and exchange holidays.
#
# Intraday: polls the TAIEX level every INTRADAY_INTERVAL_SECONDS from 09:00
# to the 13:30 close (plus one closing tick). The value is clamped UP to the
# slowest registered source's floor — 60 s for TWSE MIS, whose terms allow
# viewing, not high-frequency collection — so a smaller number is ignored
# with a warning. A faster cadence needs a licensed IntradayQuoteProvider
# (src/lib/providers/types.ts).
INTRADAY_INTERVAL_SECONDS="60"

# After-hours pipeline: every 5 minutes from 13:30 until each dataset of the
# newest published session is stored. Comma-separated cron expressions (cron
# cannot say "from 13:30" inside an hour range, hence two).
CRON_PIPELINE_SCHEDULE="30-55/5 13 * * 1-5,*/5 14-23 * * 1-5"
CRON_TIMEZONE="Asia/Taipei"

# After-hours pipeline: stop waiting for per-stock institutional flows (T86 /
# TPEx 三大法人) at this Asia/Taipei time (HH:MM). After one last attempt the
# session's scores, sentiment, alerts and brief are finalized without them.
# Read by every pipeline caller and by /admin/data-health. Moving it later
# than 21:00 means moving the vercel.json safety-net cron later too.
PIPELINE_FLOW_DEADLINE="21:00"

# Base URL of the deployed instance, e.g. "https://your-app.vercel.app".
# REQUIRED in production when jobs run outside the deployment (`npm run cron`,
# `npm run jobs:daily`, `npm run db:backfill`, `npm run import:indicators`, or
# the GitHub Actions schedule): they POST /api/jobs/revalidate afterwards to
# expire the deployment's cached pages. Without it the job still succeeds but
# the dashboard can serve pre-job data, which looks exactly like the job having
# silently failed. Leave empty for purely local work — the scripts then log a
# warning and skip it rather than failing.
APP_URL=""

# ---------------------------------------------------------------------------
# Admin (data health)
# ---------------------------------------------------------------------------
# Protects /admin/* and /api/admin/*. Send it as `Authorization: Bearer <token>`
# or sign in at /admin/login (the cookie stores a SHA-256 of it, never the
# token). Required in production: unset there, the admin area answers 503.
# Unset in development, it is open with a banner. Use a long random value,
# e.g. `openssl rand -hex 32`.
ADMIN_TOKEN=""
