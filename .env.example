# Copy to .env.

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# DATABASE_URL is the pooled connection the app runs on.
# DATABASE_URL_UNPOOLED is the direct connection `prisma migrate` needs — a
# migration run through a transaction pooler hangs. BOTH are required: Prisma
# refuses to load the schema if either is unset, so `prisma generate` fails at
# build time too.
#
# Vercel + Neon (Storage -> Neon) injects both names automatically.
# On a plain Postgres with no pooler, point them at the same string.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/dbname?sslmode=require"

# ---------------------------------------------------------------------------
# Data providers
# ---------------------------------------------------------------------------
# "live" (default) pulls official TWSE / TPEx / MOPS / SEC feeds. No API key
# is needed — every source is public — but outbound HTTPS must be allowed.
# "mock" restores the synthetic demo dataset. The two are mutually exclusive
# on purpose: a half-live database (real prices, invented flows) is worse than
# either. Switching modes means re-seeding.
DATA_MODE="live"

# ---------------------------------------------------------------------------
# AI daily brief
# ---------------------------------------------------------------------------
# "mock" (default) uses a rule-based composer and needs no API key.
# "openai" or "claude" call the real APIs and fall back to mock on failure.
AI_PROVIDER="mock"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------
# Required in production: POST /api/jobs/* checks this as a bearer token.
# With no secret set, the job routes are allowed only outside production.
CRON_SECRET=""

# Used by `npm run cron` (the long-running local scheduler). Intraday polls
# the TAIEX level every minute across the three expressions below (they
# together cover 08:30-13:30 — cron has no way to span an hour boundary in
# one expression); the pipeline check polls every 5 minutes afterwards but is
# a no-op past the first successful run each day (see hasTodaysSession in
# src/lib/jobs/refresh-data.ts).
CRON_INTRADAY_SCHEDULE="30-59 8 * * 1-5,* 9-12 * * 1-5,0-30 13 * * 1-5"
CRON_PIPELINE_SCHEDULE="*/5 13-23 * * 1-5"
CRON_TIMEZONE="Asia/Taipei"

# REQUIRED in production. The daily job POSTs here to expire the cached read
# layer after it writes. Without it the job still succeeds but the dashboard
# can serve pre-job data for up to a day, which looks exactly like the job
# having silently failed.
APP_URL="https://your-deployment.vercel.app"

# Base URL of the deployed instance, e.g. "https://your-app.vercel.app".
# Only needed when jobs are driven from the CLI (`npm run jobs:daily`,
# `npm run cron`, `npm run db:backfill`, `npm run import:indicators`) against a
# deployment: those scripts POST /api/jobs/revalidate afterwards to expire its
# cached pages. Leave empty for purely local work — the scripts then log a
# warning and skip it rather than failing.
APP_URL=""
